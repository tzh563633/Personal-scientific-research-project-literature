APP_NAME=Research Data Platform
ENVIRONMENT=development
SECRET_KEY=generate-a-long-random-secret-here
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=209715200
RUN_TASKS_INLINE=false
DEFAULT_LLM=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=research-platform@localhost
AGENT_TOKEN=generate-a-long-random-agent-token-here
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=generate-a-random-database-password-here
BACKUP_ROOT=/app/storage/backups
BACKUP_RETENTION_DAYS=14
OCR_ENABLED=false
GROBID_URL=http://grobid:8070
OUTBOUND_ALLOWED_HOSTS=
FRONTEND_PORT=80
